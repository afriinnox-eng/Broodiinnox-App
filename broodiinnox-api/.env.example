# ------------------------------------------------------------------
# Broodiinnox API — environment
# Copy to .env and fill in. Everything except DATABASE_URL has a
# working default so the server starts and talks MQTT out of the box.
# ------------------------------------------------------------------

# --- CockroachDB (Postgres wire protocol) ---------------------------
# Free serverless cluster: https://www.cockroachlabs.com/docs/cockroachdbcloud/quickstart
# Example: postgresql://user:pass@host:26257/defaultdb?sslmode=verify-full
# Leave unset => in-memory store (dev only; nothing is persisted).
DATABASE_URL=

# --- MQTT broker (must match what the firmware flashes with) --------
# The firmware (BROODIINNOX_V11.ino) defaults to broker.hivemq.com on
# port 1883 with no credentials. Public brokers are open: every device
# whose topic you know can be commanded by anyone, and a command from
# this server will fight a hacker's command. For real deployments point
# both this server AND the devices at a private broker (HiveMQ Cloud /
# EMQX / Mosquitto on a VPS) and set credentials here + in the firmware.
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Topic namespace (must match firmware DEVICE_ID prefix) ----------
MQTT_TOPIC_PREFIX=BROODIINNOX

# --- API key for dashboard<->server calls ---------------------------
# Comma-separated list. The dashboard sends it as `X-API-Key: <key>`.
# Leave empty to allow unauthenticated access (dev only).
API_KEYS=

# --- MTN Mobile Money (MoMo) Collections ----------------------------
# Without these three, farmers can still browse the app but no payment can
# be requested: POST /api/payments answers 503 and names what is missing
# (GET /api/health reports `momo.enabled`), so a deployment that is half
# configured is never mistaken for a working one.
#
# Get them from the MTN MoMo developer portal (https://momodeveloper.mtn.com):
#   sandbox: subscribe to the Collections product, then create an API user
#            (POST /v1_0/apiuser) and an API key (POST /v1_0/apiuser/<id>/apikey)
#   live:    MTN Rwanda onboards you and issues the same three values
#
# MOMO_SUBSCRIPTION_KEY     the Collections product's subscription key (Ocp-Apim-Subscription-Key)
# MOMO_API_USER             the API user UUID you created
# MOMO_API_KEY              that user's API key
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_CURRENCY=RWF
MOMO_COUNTRY_CODE=250
# Where MTN posts its verdict (optional but recommended). Must be a public
# https URL — e.g. https://broodiinnox-api.onrender.com/api/payments/momo/callback.
# The app also polls for the status, so payments still complete without it.
MOMO_CALLBACK_URL=
MOMO_TIMEOUT_MS=15000
