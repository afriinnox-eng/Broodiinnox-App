# ------------------------------------------------------------------
# Broodiinnox API — environment
# Copy to .env and fill in. Everything except DATABASE_URL has a
# working default so the server starts and talks MQTT out of the box.
# ------------------------------------------------------------------

# --- CockroachDB (Postgres wire protocol) ---------------------------
# Free serverless cluster: https://www.cockroachlabs.com/docs/cockroachdbcloud/quickstart
# Example: postgresql://user:pass@host:26257/defaultdb?sslmode=verify-full
# Leave unset => in-memory store (dev only; nothing is persisted).
DATABASE_URL=

# --- MQTT broker (must match what the firmware flashes with) --------
# The firmware (BROODIINNOX_V11.ino) defaults to broker.hivemq.com on
# port 1883 with no credentials. Public brokers are open: every device
# whose topic you know can be commanded by anyone, and a command from
# this server will fight a hacker's command. For real deployments point
# both this server AND the devices at a private broker (HiveMQ Cloud /
# EMQX / Mosquitto on a VPS) and set credentials here + in the firmware.
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Topic namespace (must match firmware DEVICE_ID prefix) ----------
MQTT_TOPIC_PREFIX=BROODIINNOX

# --- API key for dashboard<->server calls ---------------------------
# Comma-separated list. The dashboard sends it as `X-API-Key: <key>`.
# Leave empty to allow unauthenticated access (dev only).
API_KEYS=

# --- Ekorana Payment Gateway ("Ekopay") — MTN Mobile Money collections ---
# Without a key and a merchant number, farmers can still browse the app but no
# payment can be requested: POST /api/payments answers 503 and names what is
# still to be set (GET /api/health reports `ekopay.enabled`), so a deployment
# that is half configured is never mistaken for a working one.
#
# The gateway collects on MTN Mobile Money: the farmer approves a prompt on
# their phone, the money lands on your merchant MTN number, and the gateway
# tells this server whether it arrived. API documentation:
# https://api.payment.ekorana.com/api/v1 (see also "ekopay Payment Gateway API
# Documentation.pdf" in the repo root).
#
# The key travels as the `apiKey` query parameter, so it never leaves the
# server: the browser only ever talks to this API, never to Ekorana.
EKOPAY_API_KEY=
# Your merchant MTN number: where the collected money is transferred to.
EKOPAY_TRANSFER_PHONE=
# Ekorana's own host for this API. Change it only if they give you another one.
EKOPAY_BASE_URL=https://api.payment.ekorana.com/api/v1
# Where Ekorana posts the verdict. Must be a public https URL and the gateway
# requires one on every request; this default is this deployment's callback.
# The app also polls for the status, so payments still complete without it.
EKOPAY_CALLBACK_URL=https://broodiinnox-api.onrender.com/api/payments/ekopay/callback
EKOPAY_CURRENCY=RWF
EKOPAY_COUNTRY_CODE=250
# The gateway's own floor: "amount must be at least 50".
EKOPAY_MIN_AMOUNT=50
# How long to wait for the gateway to answer. A timeout is NOT a refusal: a
# request we did not get an answer for leaves the payment PENDING, holding the
# reference the gateway knows, and the status poll asks again — because the
# collection may exist and the farmer may already have paid it.
EKOPAY_TIMEOUT_MS=20000
