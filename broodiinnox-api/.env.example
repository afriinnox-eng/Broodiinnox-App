# ------------------------------------------------------------------
# Broodiinnox API — environment
# Copy to .env and fill in. Everything except DATABASE_URL has a
# working default so the server starts and talks MQTT out of the box.
# ------------------------------------------------------------------

# --- CockroachDB (Postgres wire protocol) ---------------------------
# Free serverless cluster: https://www.cockroachlabs.com/docs/cockroachdbcloud/quickstart
# Example: postgresql://user:pass@host:26257/defaultdb?sslmode=verify-full
# Leave unset => in-memory store (dev only; nothing is persisted).
DATABASE_URL=

# --- MQTT broker (must match what the firmware flashes with) --------
# The firmware (BROODIINNOX_V11.ino) defaults to broker.hivemq.com on
# port 1883 with no credentials. Public brokers are open: every device
# whose topic you know can be commanded by anyone, and a command from
# this server will fight a hacker's command. For real deployments point
# both this server AND the devices at a private broker (HiveMQ Cloud /
# EMQX / Mosquitto on a VPS) and set credentials here + in the firmware.
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Topic namespace (must match firmware DEVICE_ID prefix) ----------
MQTT_TOPIC_PREFIX=BROODIINNOX

# --- API key for dashboard<->server calls ---------------------------
# Comma-separated list. The dashboard sends it as `X-API-Key: <key>`.
# Leave empty to allow unauthenticated access (dev only).
API_KEYS=
