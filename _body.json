{
    "branch":  "main",
    "type":  "static_site",
    "buildCommand":  "npm ci \u0026\u0026 npm run build",
    "headers":  [
                    {
                        "path":  "/*",
                        "name":  "X-Frame-Options",
                        "value":  "sameorigin"
                    }
                ],
    "name":  "broodiinnox-app",
    "repo":  "https://github.com/afriinnox-eng/Broodiinnox-App",
    "staticPublishPath":  "dist",
    "routes":  [
                   {
                       "destination":  "/index.html",
                       "source":  "/*",
                       "type":  "rewrite"
                   }
               ],
    "autoDeploy":  true
}
